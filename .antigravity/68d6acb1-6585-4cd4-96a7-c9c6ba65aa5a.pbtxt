          text: "            amountEst: ticket.amountEst || \'$200k MXN\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            leadScore: ticket.leadScore || 90,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            status: ticket.status || \'leads\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
