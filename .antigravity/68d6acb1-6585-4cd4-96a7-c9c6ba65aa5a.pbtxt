ont-code-md {\\n  font-family: \\\"JetBrains Mono\\\", monospace;\\n  font-size: 13px;\\n  line-height: 20px;\\n  letter-spacing: 0em;\\n  font-weight: 400;\\n}\\n\\n.font-label-md {\\n  font-family: \\\"JetBrains Mono\\\", monospace;\\n  font-size: 12px;\\n  line-height: 16px;\\n  letter-spacing: 0.08em;\\n  font-weight: 500;\\n}\\n\\n.font-label-xs {\\n  font-family: \\\"JetBrains Mono\\\", monospace;\\n  font-size: 10px;\\n  line-height: 14px;\\n  letter-spacing: 0.12em;\\n  font-weight: 600;\\n}\\n\\n@keyframes marquee {\\n  0% { transform: translateX(0%); }\\n  100% { transform: translateX(-50%); }\\n}\\n\\n.animate-marquee {\\n  display: flex;\\n  width: max-content;\\n  animation: marquee 35s linear infinite;\\n}\\n\\n.animate-marquee:hover {\\n  animation-play-state: paused;\\n}\\n\", \"TargetContent\":\"@import \\\"tailwindcss\\\";\\n\", \"TargetFile\":\"/src/index.css\", \"toolAction\":\"Updating index.css\", \"toolSummary\":\"Update index.css\"}"
