      arguments_json: "{\"Instruction\":\"Add custom theme tokens, typography, and styling to src/index.css\", \"ReplacementContent\":\"@import \\\"tailwindcss\\\";\\n\\n@theme {\\n  --color-surface: #0b1229;\\n  --color-surface-dim: #0b1229;\\n  --color-surface-bright: #323851;\\n  --color-surface-container-lowest: #060d24;\\n  --color-surface-container-low: #141a32;\\n  --color-surface-container: #181e36;\\n  --color-surface-container-high: #222941;\\n  --color-surface-container-highest: #2d344c;\\n  --color-on-surface: #dce1ff;\\n  --color-on-surface-variant: #bac9cc;\\n  --color-inverse-surface: #dce1ff;\\n  --color-inverse-on-surface: #292f48;\\n  --color-outline: #849396;\\n  --color-outline-variant: #3b494c;\\n  --color-surface-tint: #00daf3;\\n  --color-primary: #c3f5ff;\\n  --color-on-primary: #00363d;\\n  --color-primary-container: #00e5ff;\\n  --color-on-primary-container: #00626e;\\n  --color-inverse-primary: #006875;\\n  --color-secondary: #ebffe6;\\n  --color-on-secondary: #003911;\\n  --color-secondary-container: #00fe66;\\n  --color-on-secondary-container: #007128;\\n  --color-secondary-fixed: #6bff83;\\n  --color-secondary-fixed-dim: #00e55b;\\n  --color-tertiary: #edeaff;\\n  --color-tertiary-container: #ccccff;\\n  --color-tertiary-fixed: #e1e0ff;\\n  --color-tertiary-fixed-dim: #c0c1ff;\\n  --color-error: #ffb4ab;\\n  --color-error-container: #93000a;\\n  --color-primary-fixed: #9cf0ff;\\n  --color-primary-fixed-dim: #00daf3;\\n\\n  --font-display: \\\"Space Grotesk\\\", sans-serif;\\n  --font-headline: \\\"Space Grotesk\\\", sans-serif;\\n  --font-body: \\\"Inter\\\", sans-serif;\\n  --font-code: \\\"JetBrains Mono\\\", monospace;\\n}\\n\\n@layer base {\\n  html, body {\\n    margin: 0;\\n    padding: 0;\\n    background-color: #0b1229;\\n    color: #dce1ff;\\n    font-family: \\\"Inter\\\", sans-serif;\\n  }\\n  \\n  ::-webkit-scrollbar {\\n    display: none;\\n  }\\n  * {\\n    -ms-overflow-style: none;\\n    scrollbar-width: none;\\n  }\\n}\\