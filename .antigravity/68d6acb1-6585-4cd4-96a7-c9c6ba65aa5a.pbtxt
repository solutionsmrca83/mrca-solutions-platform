    instruction: "Add custom theme tokens, typography, and styling to src/index.css"
    replacement_infos {
      original_chunk {
        target_content: "@import \"tailwindcss\";\n"
        replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --color-surface: #0b1229;\n  --color-surface-dim: #0b1229;\n  --color-surface-bright: #323851;\n  --color-surface-container-lowest: #060d24;\n  --color-surface-container-low: #141a32;\n  --color-surface-container: #181e36;\n  --color-surface-container-high: #222941;\n  --color-surface-container-highest: #2d344c;\n  --color-on-surface: #dce1ff;\n  --color-on-surface-variant: #bac9cc;\n  --color-inverse-surface: #dce1ff;\n  --color-inverse-on-surface: #292f48;\n  --color-outline: #849396;\n  --color-outline-variant: #3b494c;\n  --color-surface-tint: #00daf3;\n  --color-primary: #c3f5ff;\n  --color-on-primary: #00363d;\n  --color-primary-container: #00e5ff;\n  --color-on-primary-container: #00626e;\n  --color-inverse-primary: #006875;\n  --color-secondary: #ebffe6;\n  --color-on-secondary: #003911;\n  --color-secondary-container: #00fe66;\n  --color-on-secondary-container: #007128;\n  --color-secondary-fixed: #6bff83;\n  --color-secondary-fixed-dim: #00e55b;\n  --color-tertiary: #edeaff;\n  --color-tertiary-container: #ccccff;\n  --color-tertiary-fixed: #e1e0ff;\n  --color-tertiary-fixed-dim: #c0c1ff;\n  --color-error: #ffb4ab;\n  --color-error-container: #93000a;\n  --color-primary-fixed: #9cf0ff;\n  --color-primary-fixed-dim: #00daf3;\n\n  --font-display: \"Space Grotesk\", sans-serif;\n  --font-headline: \"Space Grotesk\", sans-serif;\n  --font-body: \"Inter\", sans-serif;\n  --font-code: \"JetBrains Mono\", monospace;\n}\n\n@layer base {\n  html, body {\n    margin: 0;\n    padding: 0;\n    background-color: #0b1229;\n    color: #dce1ff;\n    font-family: \"Inter\", sans-serif;\n  }\n  \n  ::-webkit-scrollbar {\n    display: none;\n  }\n  * {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n}\n\n@keyframes pulse-dot {\n  0%, 100% {\n    opacity: 1;\n    transform: scale(1);\n  }\n  50% {\n    opacity: 0.4;\n    transform: scale(0.8);\n  }\n}\n\n.animate-pulse-dot {\n  animation: pulse-dot 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n.font-display-lg {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 56px;\n  line-height: 64px;\n  letter-spacing: -0.03em;\n  font-weight: 700;\n}\n\n.font-display-lg-mobile {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 36px;\n  line-height: 44px;\n  letter-spacing: -0.02em;\n  font-weight: 700;\n}\n\n.font-headline-xl {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 40px;\n  line-height: 48px;\n  letter-spacing: -0.025em;\n  font-weight: 600;\n}\n\n.font-headline-xl-mobile {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 28px;\n  line-height: 36px;\n  letter-spacing: -0.02em;\n  font-weight: 600;\n}\n\n.font-headline-lg {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 28px;\n  line-height: 36px;\n  letter-spacing: -0.02em;\n  font-weight: 600;\n}\n\n.font-headline-md {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 22px;\n  line-height: 30px;\n  letter-spacing: -0.015em;\n  font-weight: 500;\n}\n\n.font-headline-sm {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 18px;\n  line-height: 26px;\n  letter-spacing: -0.01em;\n  font-weight: 500;\n}\n\n.font-body-lg {\n  font-family: \"Inter\", sans-serif;\n  font-size: 16px;\n  line-height: 26px;\n  letter-spacing: -0.005em;\n  font-weight: 400;\n}\n\n.font-body-md {\n  font-family: \"Inter\", sans-serif;\n  font-size: 14px;\n  line-height: 22px;\n  letter-spacing: 0em;\n  font-weight: 400;\n}\n\n.font-body-sm {\n  font-family: \"Inter\", sans-serif;\n  font-size: 12px;\n  line-height: 18px;\n  letter-spacing: 0.01em;\n  font-weight: 400;\n}\n\n.font-code-md {\n  font-family: \"JetBrains Mono\", monospace;\n  font-size: 13px;\n  line-height: 20px;\n  letter-spacing: 0em;\n  font-weight: 400;\n}\n\n.font-label-md {\n  font-family: \"JetBrains Mono\", monospace;\n  font-size: 12px;\n  line-height: 16px;\n  letter-spacing: 0.08em;\n  font-weight: 500;\n}\n\n.font-label-xs {\n  font-family: \"JetBrains Mono\", monospace;\n  font-size: 10px;\n  line-height: 14px;\n  letter-spacing: 0.12em;\n  font-weight: 600;\n}\n\n@keyframes marquee {\n  0% { transform: translateX(0%); }\n  100% { transform: translateX(-50%); }\n}\n\n.animate-marquee {\n  display: flex;\n  width: max-content;\n  animation: marquee 35s linear infinite;\n}\n\n.animate-marquee:hover {\n  animation-play-state: paused;\n}\n"
      }
      num_matches: 1
    }
  }
}
