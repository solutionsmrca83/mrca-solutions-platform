  planner_response {
    thinking: "**Building App Navigation**\n\nI\'m currently focused on constructing the full application navigation shell within `src/App.tsx`. The core navigation elements include a top header featuring MCRA Solutions branding with a hexagon/terminal icon and \"MCRA SOLUTIONS\". Also, I need to incorporate a system status indicator displaying \"ALL SYSTEMS OPERATIONAL - 99.9% UPTIME\".\n\n\n**Expanding Navigation Components**\n\nI\'ve progressed to integrating the detailed navigation elements. I\'m focusing on the switcher for \"Overview\" and \"Panel Admin Socios,\" and the mobile drawer and bottom navigation bar. Also on the agenda are the scroll-to-top/bottom buttons, toast notifications, and the footer components.\n\n\n"
    tool_calls {
      id: "call_872053"
      name: "create_file"
      arguments_json: "{\"Content\":\"import React, { useState } from \'react\';\\nimport { PublicLanding } from \'./components/PublicLanding\';\\nimport { AdminEnclave } from \'./components/AdminEnclave\';\\nimport { ActiveView, ScreenMode } from \'./types\';\\n\\nexport default function App() {\\n  const [activeView, setActiveView] = useState<ActiveView>(\'public\');\\n  const [isMobileDrawerOpen, setIsMobileDrawerOpen] = useState(false);\\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\\n  const [screenMode, setScreenMode] = useState<ScreenMode>(\'responsive\');\\n\\n  const showToast = (msg: string) => {\\n    setToastMessage(msg);\\n    setTimeout(() => {\\n      setToastMessage((current) => (current === msg ? null : current));\\n    }, 3200);\\n  };\\n\\n  const scrollToTop = () => {\\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\\n  };\\n\\n  const scrollToBottom = () => {\\n    window.scrollTo({ top: document.body.scrollHeight, behavior: \'smooth\' });\\n  };\\n\\n  return (\\n    <div className=\\\"bg-[#0b1229] min-h-screen text-[#dce1ff] flex flex-col relative font-[\'Inter\'] selection:bg-[#00e5ff] selection:text-[#00363d]\\\">\\n      {/* GLOBAL TOP NAVIGATION HEADER */}\\n      <header className=\\\"fixed top-0 left-0 right-0 z-50 bg-[#060d24]/90 border-b border-[#181e36] backdrop-blur-xl shadow-[0_4px_24px_rgba(0,0,0,0.5)]\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3\\\">\\n          {/* Brand Logo & Title */}\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <button\\n              onClick={() => setIsMobileDrawerOpen(true)}\\n              className=\\\"md:hidden w-10 h-10 flex items-center justify-center text-[#00e5ff] hover:text-[#c3f5ff] transition-colors p-1\\\"\\n              aria-label=\\\"Abrir men\303\272\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[24px]\\\">menu</span>\\n            </button>\\n\\n            <button\\n              onClick={() => setActiveView(\'public\')}\\n              className=\\\"flex items-center gap-2 group text-left\\\"\\n            >\\n              <div className=\\\"w-9 h-9 rounded bg-[#181e36] border border-[#00e5ff]/30 flex items-center justify-center text-[#00e5ff] shadow-[0_0_12px_rgba(0,229,255,0.25)] group-hover:border-[#00e5ff] transition-all\\\">\\n                <span className=\\\"material-symbols-outlined text-[20px]\\\">hexagon</span>\\n              </div>\\n              <div className=\\\"flex flex-col\\\">\\n                <span className=\\\"font-[\'Space_Grotesk\'] text-[18px] font-bold tracking-tight text-[#dce1ff] leading-none group-hover:text-[#00e5ff] transition-colors\\\">\\n                  MCRA\\n                </span>\\n                <span className=\\\"font-[\'JetBrains_Mono\'] text-[9px] text-[#00daf3] uppercase tracking-widest leading-none mt-1\\\">\\n                  SOLUTIONS\\n                </span>\\n              </div>\\n            </button>\\n\\n            {/* Desktop Operational Indicator */}\\n            <div className=\\\"hidden xl:flex items-center gap-2 px-3 py-1 rounded bg-[#141a32] border border-[#00fe66]/20\\\">\\n              <span className=\\\"w-2 h-2 rounded-full bg-[#00fe66] animate-pulse shadow-[0_0_8px_#00fe66]\\\"></span>\\n              <span className=\\\"font-[\'JetBrains_Mono\'] text-[10px] text-[#00fe66] uppercase font-semibold\\\">\\n                ALL SYSTEMS OPERATIONAL \342\200\224 99.9% UPTIME\\n              </span>\\n            </div>\\n          </div>\\n\\n          {/* Desktop Navigation Tabs */}\\n          <nav className=\\\"hidden md:flex items-center gap-2\\\">\\n            <button\\n              onClick={() => setActiveView(\'public\')}\\n              className={`px-3.5 py-1.5 rounded-lg font-[\'Space_Grotesk\'] text-[14px] uppercase tracking-wider font-semibold transition-all ${\\n                activeView === \'public\'\\n                  ? \'bg-[#00e5ff] text-[#00363d] shadow-[0_0_15px_rgba(0,229,255,0.3)]\'\\n                  : \'text-[#bac9cc] hover:text-[#00e5ff] hover:bg-[#141a32]\'\\n              }`}\\n            >\\n              Overview & Trust Center\\n            </button>\\n            <button\\n              onClick={() => setActiveView(\'admin\')}\\n              className={`px-3.5 py-1.5 rounded-lg font-[\'Space_Grotesk\'] text-[14px] uppercase tracking-wider font-semibold transition-all flex items-center gap-1.5 ${\\n                activeView === \'admin\'\\n                  ? \'bg-[#00e5ff] text-[#00363d] shadow-[0_0_15px_rgba(0,229,255,0.3)]\'\\n                  : \'text-[#bac9cc] hover:text-[#00e5ff] hover:bg-[#141a32]\'\\n              }`}\\n            >\\n              <span className=\\\"material-symbols-outlined text-[16px]\\\">admin_panel_settings</span>\\n              <span>Panel Admin Socios</span>\\n            </button>\\n          </nav>\\n\\n          {/* Right Action & Device Switcher */}\\n          <div className=\\\"flex items-center gap-2 sm:gap-3\\\">\\n            {/* View Mode Simulator Pill */}\\n            <div className=\\\"hidden sm:flex items-center bg-[#141a32] border border-[#222941] rounded-lg p-0.5 text-[11px] font-[\'JetBrains_Mono\']\\\">\\n              <button\\n                onClick={() => setScreenMode(\'responsive\')}\\n                className={`px-2 py-1 rounded transition-colors ${\\n                  screenMode === \'responsive\' ? \'bg-[#00e5ff] text-[#00363d] font-bold\' : \'text-[#bac9cc] hover:text-[#dce1ff]\'\\n                }`}\\n                title=\\\"Dise\303\261o Adaptativo Fluido\\\"\\n              >\\n                Auto\\n              </button>\\n              <button\\n                onClick={() => setScreenMode(\'mobile-mock\')}\\n                className={`px-2 py-1 rounded transition-colors flex items-center gap-1 ${\\n                  screenMode === \'mobile-mock\' ? \'bg-[#00e5ff] text-[#00363d] font-bold\' : \'text-[#bac9cc] hover:text-[#dce1ff]\'\\n                }`}\\n                title=\\\"Simulador M\303\263vil (Screens 1 & 3)\\\"\\n              >\\n                <span className=\\\"material-symbols-outlined text-[13px]\\\">smartphone</span>\\n                <span>M\303\263vil</span>\\n              </button>\\n              <button\\n                onClick={() => setScreenMode(\'desktop-mock\')}\\n                className={`px-2 py-1 rounded transition-colors flex items-center gap-1 ${\\n                  screenMode === \'desktop-mock\' ? \'bg-[#00e5ff] text-[#00363d] font-bold\' : \'text-[#bac9cc] hover:text-[#dce1ff]\'\\n                }`}\\n                title=\\\"Simulador Desktop (Screens 5 & 7)\\\"\\n              >\\n                <span className=\\\"material-symbols-outlined text-[13px]\\\">desktop_windows</span>\\n                <span>Desktop</span>\\n              </button>\\n            </div>\\n\\n            {/* Zero Trust Status */}\\n            <div className=\\\"hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#141a32] border border-[#00e5ff]/20 text-[#bac9cc]\\\">\\n              <span className=\\\"material-symbols-outlined text-[15px] text-[#00e5ff]\\\">lock</span>\\n              <span className=\\\"font-[\'JetBrains_Mono\'] text-[10px] uppercase font-semibold text-[#00daf3]\\\">\\n                Zero Trust v2.4\\n              </span>\\n            </div>\\n\\n            {/* User Avatar Profile */}\\n            <button\\n              onClick={() => setActiveView(activeView === \'public\' ? \'admin\' : \'public\')}\\n              className=\\\"w-9 h-9 rounded-full bg-[#00e5ff] text-[#00363d] flex items-center justify-center hover:bg-[#c3f5ff] transition-all shadow-[0_0_10px_rgba(0,229,255,0.3)]\\\"\\n              title={activeView === \'public\' ? \'Abrir Panel Admin Socios\' : \'Volver a Vista P\303\272blica\'}\\n            >\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">person</span>\\n            </button>\\n          </div>\\n        </div>\\n      </header>\\n\\n      {/* MOBILE DRAWER NAVIGATION (Exact to Image 1) */}\\n      <div\\n        className={`fixed inset-0 z-50 bg-[#060d24]/80 backdrop-blur-sm transition-opacity duration-300 ${\\n          isMobileDrawerOpen ? \'opacity-100 pointer-events-auto\' : \'opacity-0 pointer-events-none\'\\n        }`}\\n        onClick={() => setIsMobileDrawerOpen(false)}\\n      />\\n      <aside\\n        className={`fixed top-0 right-0 h-full w-80 max-w-[85vw] z-50 bg-[#141a32]/95 border-l border-[#00e5ff]/30 backdrop-blur-2xl shadow-[-8px_0_32px_rgba(0,0,0,0.7)] transform transition-transform duration-300 ease-out flex flex-col justify-between pt-safe pb-safe ${\\n          isMobileDrawerOpen ? \'translate-x-0\' : \'translate-x-full\'\\n        }`}\\n      >\\n        <div className=\\\"p-6 flex flex-col gap-6\\\">\\n          <div className=\\\"flex items-center justify-between pb-3 border-b border-[#222941]\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <div className=\\\"w-8 h-8 rounded bg-[#060d24] flex items-center justify-center text-[#00e5ff]\\\">\\n                <span className=\\\"material-symbols-outlined text-[20px]\\\">shield</span>\\n              </div>\\n              <span className=\\\"font-[\'Space_Grotesk\'] text-[18px] text-[#00e5ff] tracking-tight font-bold\\\">\\n                SISTEMA MCRA\\n              </span>\\n            </div>\\n            <button\\n              onClick={() => setIsMobileDrawerOpen(false)}\\n              className=\\\"w-9 h-9 flex items-center justify-center text-[#bac9cc] hover:text-[#dce1ff]\\\"\\n              aria-label=\\\"Cerrar navegaci\303\263n\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[24px]\\\">close</span>\\n            </button>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2 px-3 py-2 rounded-lg bg-[#060d24] border border-[#00fe66]/20\\\">\\n            <span className=\\\"w-2 h-2 rounded-full bg-[#00fe66] shadow-[0_0_8px_rgba(0,254,102,0.8)] animate-pulse-dot\\\"></span>\\n            <span className=\\\"font-[\'JetBrains_Mono\'] text-[12px] text-[#00fe66] font-semibold\\\">\\n              CORE TELEMETRY: 99.98%\\n            </span>\\n          </div>\\n\\n          <nav className=\\\"flex flex-col gap-2\\\">\\n            <button\\n              onClick={() => {\\n                setActiveView(\'public\');\\n                setIsMobileDrawerOpen(false);\\n              }}\\n              className={`flex items-center gap-3 px-4 py-3 rounded-lg text-left transition-all ${\\n                activeView === \'public\'\\n                  ? \'bg-[#00e5ff]/15 text-[#00e5ff] border border-[#00e5ff]/30 font-semibold\'\\n                  : \'text-[#bac9cc] hover:bg-[#181e36] hover:text-[#dce1ff]\'\\n              }`}\\n            >\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">grid_view</span>\\n              <span className=\\\"font-[\'Space_Grotesk\'] text-[16px]\\\">Inicio</span>\\n            </button>\\n\\n            <a\\n              href=\\\"#arquitectura\\\"\\n              onClick={() => {\\n                setActiveView(\'public\');\\n                setIsMobileDrawerOpen(false);\\n              }}\\n              className=\\\"flex items-center gap-3 px-4 py-3 rounded-lg text-[#bac9cc] hover:bg-[#181e36] hover:text-[#00e5ff] transition-all\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">hub</span>\\n              <span className=\\\"font-[\'Space_Grotesk\'] text-[16px]\\\">Arquitectura</span>\\n            </a>\\n\\n            <a\\n              href=\\\"#seguridad-cifrado\\\"\\n              onClick={() => {\\n                setActiveView(\'public\');\\n                setIsMobileDrawerOpen(false);\\n              }}\\n              className=\\\"flex items-center gap-3 px-4 py-3 rounded-lg text-[#bac9cc] hover:bg-[#181e36] hover:text-[#00e5ff] transition-all\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">lock</span>\\n              <span className=\\\"font-[\'Space_Grotesk\'] text-[16px]\\\">Seguridad</span>\\n            </a>\\n\\n            <a\\n              href=\\\"#portal-privado\\\"\\n              onClick={() => {\\n                setActiveView(\'public\');\\n                setIsMobileDrawerOpen(false);\\n              }}\\n              className=\\\"flex items-center gap-3 px-4 py-3 rounded-lg text-[#bac9cc] hover:bg-[#181e36] hover:text-[#00e5ff] transition-all\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">terminal</span>\\n              <span className=\\\"font-[\'Space_Grotesk\'] text-[16px]\\\">Portal Clientes</span>\\n            </a>\\n\\n            <button\\n              onClick={() => {\\n                setActiveView(\'admin\');\\n                setIsMobileDrawerOpen(false);\\n              }}\\n              className={`flex items-center gap-3 px-4 py-3 rounded-lg text-left transition-all ${\\n                activeView === \'admin\'\\n                  ? \'bg-[#00e5ff]/15 text-[#00e5ff] border border-[#00e5ff]/30 font-semibold\'\\n                  : \'text-[#bac9cc] hover:bg-[#181e36] hover:text-[#dce1ff]\'\\n              }`}\\n            >\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">admin_panel_settings</span>\\n              <span className=\\\"font-[\'Space_Grotesk\'] text-[16px]\\\">Panel Admin Socios</span>\\n            </button>\\n          </nav>\\n        </div>\\n\\n        <div className=\\\"p-6 bg-[#060d24] border-t border-[#181e36]\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-10 h-10 rounded bg-[#00e5ff]/10 border border-[#00e5ff]/30 flex items-center justify-center text-[#00e5ff]\\\">\\n              <span className=\\\"material-symbols-outlined text-[22px]\\\">verified_user</span>\\n            </div>\\n            <div>\\n              <p className=\\\"font-[\'JetBrains_Mono\'] text-[13px] text-[#dce1ff] font-semibold\\\">\\n                Acceso Zero-Trust\\n              </p>\\n              <p className=\\\"font-[\'JetBrains_Mono\'] text-[11px] text-[#00fe66]\\\">v2.4.1 SECURED</p>\\n            </div>\\n          </div>\\n        </div>\\n      </aside>\\n\\n      {/* MAIN VIEW CONTAINER WITH OPTIONAL SCREEN MODE FRAMING */}\\n      <main className=\\\"flex-1 w-full pt-16 flex flex-col items-center\\\">\\n        {screenMode === \'mobile-mock\' ? (\\n          <div className=\\\"w-full flex justify-center py-6 px-2 bg-[#060d24]/60\\\">\\n            <div className=\\\"w-full max-w-[420px] rounded-[32px] border-4 border-[#222941] bg-[#0b1229] shadow-[0_20px_50px_rgba(0,0,0,0.8),0_0_30px_rgba(0,229,255,0.15)] overflow-hidden flex flex-col min-h-[844px]\\\">\\n              {/* Mobile Mock Top Speaker Bar */}\\n              <div className=\\\"w-full h-6 bg-[#141a32] flex items-center justify-center\\\">\\n                <div className=\\\"w-20 h-3.5 bg-[#060d24] rounded-full\\\"></div>\\n              </div>\\n              <div className=\\\"flex-1 overflow-y-auto\\\">\\n                {activeView === \'public\' ? (\\n                  <PublicLanding\\n                    onNavigateToAdmin={() => setActiveView(\'admin\')}\\n                    isMobileDrawerOpen={isMobileDrawerOpen}\\n                    setIsMobileDrawerOpen={setIsMobileDrawerOpen}\\n                  />\\n                ) : (\\n                  <AdminEnclave\\n                    onBackToPublic={() => setActiveView(\'public\')}\\n                    showToast={showToast}\\n                  />\\n                )}\\n              </div>\\n            </div>\\n          </div>\\n        ) : screenMode === \'desktop-mock\' ? (\\n          <div className=\\\"w-full flex justify-center py-6 px-4 bg-[#060d24]/60\\\">\\n            <div className=\\\"w-full max-w-[1400px] rounded-2xl border border-[#222941] bg-[#0b1229] shadow-2xl overflow-hidden flex flex-col\\\">\\n              <div className=\\\"w-full h-8 bg-[#141a32] px-4 flex items-center justify-between border-b border-[#222941]\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <span className=\\\"w-3 h-3 rounded-full bg-[#ffb4ab]\\\"></span>\\n                  <span className=\\\"w-3 h-3 rounded-full bg-[#ffd260]\\\"></span>\\n                  <span className=\\\"w-3 h-3 rounded-full bg-[#00fe66]\\\"></span>\\n                  <span className=\\\"font-[\'JetBrains_Mono\'] text-[11px] text-[#bac9cc] ml-2\\\">\\n                    mcra.enterprise.enclave \342\200\224 HTTPS TLS 1.3\\n                  </span>\\n                </div>\\n                <span className=\\\"font-[\'JetBrains_Mono\'] text-[10px] text-[#00e5ff]\\\">ENCLAVE SECURE HOST</span>\\n              </div>\\n              <div className=\\\"flex-1\\\">\\n                {activeView === \'public\' ? (\\n                  <PublicLanding\\n                    onNavigateToAdmin={() => setActiveView(\'admin\')}\\n                    isMobileDrawerOpen={isMobileDrawerOpen}\\n                    setIsMobileDrawerOpen={setIsMobileDrawerOpen}\\n                  />\\n                ) : (\\n                  <AdminEnclave\\n                    onBackToPublic={() => setActiveView(\'public\')}\\n                    showToast={showToast}\\n                  />\\n                )}\\n              </div>\\n            </div>\\n          </div>\\n        ) : (\\n          <div className=\\\"w-full\\\">\\n            {activeView === \'public\' ? (\\n              <PublicLanding\\n                onNavigateToAdmin={() => setActiveView(\'admin\')}\\n                isMobileDrawerOpen={isMobileDrawerOpen}\\n                setIsMobileDrawerOpen={setIsMobileDrawerOpen}\\n              />\\n            ) : (\\n              <AdminEnclave\\n                onBackToPublic={() => setActiveView(\'public\')}\\n                showToast={showToast}\\n              />\\n            )}\\n          </div>\\n        )}\\n      </main>\\n\\n      {/* FLOATING ACTION ARROWS (Scroll up and down) - Exact to all images */}\\n      <div className=\\\"fixed right-4 bottom-20 md:bottom-8 z-40 flex flex-col gap-2\\\">\\n        <button\\n          onClick={scrollToTop}\\n          aria-label=\\\"Desplazar hacia arriba\\\"\\n          className=\\\"w-10 h-10 rounded-full bg-[#181e36]/90 border border-[#00e5ff]/40 text-[#00e5ff] flex items-center justify-center backdrop-blur-xl shadow-[0_0_16px_rgba(0,229,255,0.25)] hover:bg-[#00e5ff] hover:text-[#00363d] transition-all\\\"\\n        >\\n          <span className=\\\"material-symbols-outlined text-[20px]\\\">arrow_upward</span>\\n        </button>\\n        <button\\n          onClick={scrollToBottom}\\n          aria-label=\\\"Desplazar hacia abajo\\\"\\n          className=\\\"w-10 h-10 rounded-full bg-[#181e36]/90 border border-[#00e5ff]/40 text-[#00e5ff] flex items-center justify-center backdrop-blur-xl shadow-[0_0_16px_rgba(0,229,255,0.25)] hover:bg-[#00e5ff] hover:text-[#00363d] transition-all\\\"\\n        >\\n          <span className=\\\"material-symbols-outlined text-[20px]\\\">arrow_downward</span>\\n        </button>\\n      </div>\\n\\n      {/* MOBILE BOTTOM NAVIGATION BAR (Exact to Image 1) */}\\n      <nav className=\\\"md:hidden fixed bottom-0 left-0 right-0 z-40 pb-safe bg-[#060d24]/95 border-t border-[#181e36] backdrop-blur-xl shadow-[0_-4px_24px_rgba(0,0,0,0.5)]\\\">\\n        <div className=\\\"flex justify-around items-center h-16 px-2\\\">\\n          <button\\n            onClick={() => setActiveView(\'public\')}\\n            className={`flex flex-col items-center justify-center gap-1 w-14 h-14 transition-colors ${\\n              activeView === \'public\' ? \'text-[#00e5ff] font-semibold\' : \'text-[#bac9cc] hover:text-[#dce1ff]\'\\n            }`}\\n          >\\n            <span className=\\\"material-symbols-outlined text-[22px]\\\">home</span>\\n            <span className=\\\"font-[\'JetBrains_Mono\'] text-[10px]\\\">Inicio</span>\\n          </button>\\n          <a\\n            href=\\\"#arquitectura\\\"\\n            onClick={() => setActiveView(\'public\')}\\n            className=\\\"flex flex-col items-center justify-center gap-1 w-14 h-14 text-[#bac9cc] hover:text-[#00e5ff] transition-colors\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-[22px]\\\">hub</span>\\n            <span className=\\\"font-[\'JetBrains_Mono\'] text-[10px]\\\">Arquitectura</span>\\n          </a>\\n          <a\\n            href=\\\"#seguridad-cifrado\\\"\\n            onClick={() => setActiveView(\'public\')}\\n            className=\\\"flex flex-col items-center justify-center gap-1 w-14 h-14 text-[#bac9cc] hover:text-[#00e5ff] transition-colors\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-[22px]\\\">security</span>\\n            <span className=\\\"font-[\'JetBrains_Mono\'] text-[10px]\\\">Seguridad</span>\\n          </a>\\n          <button\\n            onClick={() => setActiveView(\'admin\')}\\n            className={`flex flex-col items-center justify-center gap-1 w-14 h-14 transition-colors ${\\n              activeView === \'admin\' ? \'text-[#00e5ff] font-semibold\' : \'text-[#bac9cc] hover:text-[#dce1ff]\'\\n            }`}\\n          >\\n            <span className=\\\"material-symbols-outlined text-[22px]\\\">admin_panel_settings</span>\\n            <span className=\\\"font-[\'JetBrains_Mono\'] text-[10px]\\\">Socios</span>\\n          </button>\\n        </div>\\n      </nav>\\n\\n      {/* FOOTER */}\\n      <footer className=\\\"w-full bg-[#060d24] border-t border-[#181e36] py-8 text-center md:text-left\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4\\\">\\n          <div className=\\\"flex flex-col items-center md:items-start gap-1\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <span className=\\\"font-[\'Space_Grotesk\'] text-[16px] text-[#dce1ff] font-bold\\\">MCRA Solutions</span>\\n              <span className=\\\"font-[\'JetBrains_Mono\'] text-[10px] px-2 py-0.5 rounded bg-[#181e36] text-[#00daf3]\\\">\\n                SYS.VER.4.12\\n              </span>\\n            </div>\\n            <p className=\\\"font-[\'Inter\'] text-[12px] text-[#bac9cc]\\\">\\n              Operational precision and zero-trust high-assurance systems architecture.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-4 font-[\'JetBrains_Mono\'] text-[11px] text-[#bac9cc] uppercase\\\">\\n            <span className=\\\"hover:text-[#00e5ff] cursor-pointer\\\">SOC2 Type II</span>\\n            <span>\342\200\242</span>\\n            <span className=\\\"hover:text-[#00e5ff] cursor-pointer\\\">ISO 27001</span>\\n            <span>\342\200\242</span>\\n            <span className=\\\"hover:text-[#00e5ff] cursor-pointer\\\">Encrypted Enclave</span>\\n          </div>\\n\\n          <div className=\\\"font-[\'JetBrains_Mono\'] text-[11px] text-[#849396]\\\">\\n            \302\251 2025-2026 MCRA Solutions Inc. All rights reserved.\\n          </div>\\n        </div>\\n      </footer>\\n\\n      {/* FLOATING HUD TOAST NOTIFICATION */}\\n      {toastMessage && (\\n        <div className=\\\"fixed top-20 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-xl bg-[#141a32] border border-[#00e5ff]/50 shadow-[0_10px_30px_rgba(0,0,0,0.8),0_0_20px_rgba(0,229,255,0.3)] flex items-center gap-3 animate-bounce\\\">\\n          <span className=\\\"material-symbols-outlined text-[#00fe66] text-[22px]\\\">check_circle</span>\\n          <span className=\\\"font-[\'JetBrains_Mono\'] text-[12px] text-[#dce1ff] font-medium\\\">{toastMessage}</span>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Creating src/App.tsx\", \"toolSummary\":\"Create App.tsx component\"}"
