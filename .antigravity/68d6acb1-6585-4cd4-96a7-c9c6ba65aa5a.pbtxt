se-dot 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n.font-display-lg {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 56px;\n  line-height: 64px;\n  letter-spacing: -0.03em;\n  font-weight: 700;\n}\n\n.font-display-lg-mobile {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 36px;\n  line-height: 44px;\n  letter-spacing: -0.02em;\n  font-weight: 700;\n}\n\n.font-headline-xl {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 40px;\n  line-height: 48px;\n  letter-spacing: -0.025em;\n  font-weight: 600;\n}\n\n.font-headline-xl-mobile {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 28px;\n  line-height: 36px;\n  letter-spacing: -0.02em;\n  font-weight: 600;\n}\n\n.font-headline-lg {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 28px;\n  line-height: 36px;\n  letter-spacing: -0.02em;\n  font-weight: 600;\n}\n\n.font-headline-md {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 22px;\n  line-height: 30px;\n  letter-spacing: -0.015em;\n  font-weight: 500;\n}\n\n.font-headline-sm {\n  font-family: \"Space Grotesk\", sans-serif;\n  font-size: 18px;\n  line-height: 26px;\n  letter-spacing: -0.01em;\n  font-weight: 500;\n}\n\n.font-body-lg {\n  font-family: \"Inter\", sans-serif;\n  font-size: 16px;\n  line-height: 26px;\n  letter-spacing: -0.005em;\n  font-weight: 400;\n}\n\n.font-body-md {\n  font-family: \"Inter\", sans-serif;\n  font-size: 14px;\n  line-height: 22px;\n  letter-spacing: 0em;\n  font-weight: 400;\n}\n\n.font-body-sm {\n  font-family: \"Inter\", sans-serif;\n  font-size: 12px;\n  line-height: 18px;\n  letter-spacing: 0.01em;\n  font-weight: 400;\n}\n\n.font-code-md {\n  font-family: \"JetBrains Mono\", monospace;\n  font-size: 13px;\n  line-height: 20px;\n  letter-spacing: 0em;\n  font-weight: 400;\n}\n\n.font-label-md {\n  font-family: \"JetBrains Mono\", monospace;\n  font-size: 12px;\n  line-height: 16px;\n  letter-spacing: 0.08em;\n  font-weight: 500;\n}\n\n.font-label-xs 