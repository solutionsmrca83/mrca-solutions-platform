          text: "          };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setTickets((prev) => [newT, ...prev]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          showToast(`Ticket #${newT.id} registrado en el Pipeline.`);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
